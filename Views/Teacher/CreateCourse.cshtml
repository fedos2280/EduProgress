
@model EduProgress.ViewModels.CreateCourseViewModel

@{
    ViewData["Title"] = "Створити курс";
}

<div class="container py-5">

    <a asp-controller="Teacher"
       asp-action="Index"
       class="btn btn-outline-secondary mb-4">
        <i class="bi bi-arrow-left"></i>
        Назад до кабінету
    </a>

    <div class="glass-card p-4 p-md-5">

        <h1 class="fw-bold mb-2">
            <i class="bi bi-plus-circle"></i>
            Створити новий курс
        </h1>

        <p class="mb-4">
            Заповни інформацію про навчальний курс.
        </p>

        <form asp-controller="Teacher"
              asp-action="CreateCourse"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title"
                       class="form-label"></label>

                <input asp-for="Title"
                       class="form-control"
                       placeholder="Наприклад: Основи C#" />

                <span asp-validation-for="Title"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description"
                       class="form-label"></label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Опиши, чого навчиться студент"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>

            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <label asp-for="Category"
                           class="form-label"></label>

                    <input asp-for="Category"
                           class="form-control" />

                    <span asp-validation-for="Category"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Level"
                           class="form-label"></label>

                    <select asp-for="Level"
                            class="form-select">
                        <option value="Початковий">Початковий</option>
                        <option value="Середній">Середній</option>
                        <option value="Просунутий">Просунутий</option>
                    </select>

                    <span asp-validation-for="Level"
                          class="text-danger"></span>
                </div>

            </div>

            <button type="submit"
                    class="btn btn-primary btn-lg">
                <i class="bi bi-check-circle"></i>
                Зберегти курс
            </button>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
