
@model EduProgress.ViewModels.EditQuestionViewModel

@{
    ViewData["Title"] = "Редагування запитання";
}

<div class="container py-5">

    <a asp-controller="Teacher"
       asp-action="Index"
       class="btn btn-outline-secondary mb-4">
        <i class="bi bi-arrow-left"></i>
        Назад до кабінету
    </a>

    <div class="glass-card p-4 p-md-5">

        <span class="badge bg-primary mb-3">
            Керування тестами
        </span>

        <h1 class="fw-bold mb-3">
            <i class="bi bi-pencil-square"></i>
            Редагування запитання
        </h1>

        <p class="mb-4">
            Зміни текст запитання, варіанти відповідей
            або правильну відповідь.
        </p>

        <form asp-controller="Teacher"
              asp-action="EditQuestion"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />
            <input asp-for="CourseId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="QuestionText"
                       class="form-label"></label>

                <textarea asp-for="QuestionText"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="QuestionText"
                      class="text-danger"></span>
            </div>

            <div class="row g-3 mb-4">

                <div class="col-md-6">
                    <label asp-for="OptionA"
                           class="form-label"></label>

                    <input asp-for="OptionA"
                           class="form-control" />

                    <span asp-validation-for="OptionA"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="OptionB"
                           class="form-label"></label>

                    <input asp-for="OptionB"
                           class="form-control" />

                    <span asp-validation-for="OptionB"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="OptionC"
                           class="form-label"></label>

                    <input asp-for="OptionC"
                           class="form-control" />

                    <span asp-validation-for="OptionC"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="OptionD"
                           class="form-label"></label>

                    <input asp-for="OptionD"
                           class="form-control" />

                    <span asp-validation-for="OptionD"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="mb-4">
                <label asp-for="CorrectAnswer"
                       class="form-label"></label>

                <select asp-for="CorrectAnswer"
                        class="form-select">
                    <option value="A">A</option>
                    <option value="B">B</option>
                    <option value="C">C</option>
                    <option value="D">D</option>
                </select>

                <span asp-validation-for="CorrectAnswer"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-success btn-lg">
                <i class="bi bi-check-circle"></i>
                Зберегти зміни
            </button>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
