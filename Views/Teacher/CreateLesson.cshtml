
@model EduProgress.ViewModels.CreateLessonViewModel

@{
    ViewData["Title"] = "Додати урок";
}

<div class="container py-5">

    <a asp-controller="Teacher"
       asp-action="Index"
       class="btn btn-outline-secondary mb-4">
        <i class="bi bi-arrow-left"></i>
        Назад до кабінету
    </a>

    <div class="glass-card p-4 p-md-5">

        <span class="badge bg-primary mb-3">
            Керування уроками
        </span>

        <h1 class="fw-bold mb-3">Додати новий урок</h1>

        <p class="mb-4">
            Курс:
            <strong>@ViewBag.CourseTitle</strong>
        </p>

        <form asp-controller="Teacher"
              asp-action="CreateLesson"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="CourseId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title"
                       class="form-label"></label>

                <input asp-for="Title"
                       class="form-control"
                       placeholder="Наприклад: Що таке C#?" />

                <span asp-validation-for="Title"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Content"
                       class="form-label"></label>

                <textarea asp-for="Content"
                          class="form-control"
                          rows="10"
                          placeholder="Введи навчальний матеріал уроку"></textarea>

                <span asp-validation-for="Content"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Order"
                       class="form-label"></label>

                <input asp-for="Order"
                       type="number"
                       min="1"
                       max="1000"
                       class="form-control" />

                <span asp-validation-for="Order"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-success btn-lg">
                <i class="bi bi-check-circle"></i>
                Зберегти урок
            </button>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
